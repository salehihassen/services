# Host-specific settings for the Home Assistant usage exporters.
# Set these in the corresponding systemd user services; keep real paths and
# credentials in untracked local configuration.
CODEX_USAGE_EXECUTABLE=/path/to/codex
CODEX_USAGE_OUTPUT=/path/to/home-assistant/config/codex_usage.json
# Optional: enable bounded renewal through Claude Code for expired tokens.
CLAUDE_USAGE_EXECUTABLE=/path/to/claude
CLAUDE_USAGE_CREDENTIALS_FILE=/path/to/claude/.credentials.json
CLAUDE_USAGE_OUTPUT=/path/to/home-assistant/config/claude_usage.json
CLAUDE_USAGE_STATE_FILE=/path/to/private/claude-usage-export/state.json
SYNTHETIC_USAGE_SECRETS_FILE=/path/to/private/shell-secrets
SYNTHETIC_USAGE_OUTPUT=/path/to/home-assistant/config/synthetic_usage.json
OLLAMA_USAGE_SECRETS_FILE=/path/to/private/shell-secrets
OLLAMA_USAGE_OUTPUT=/path/to/home-assistant/config/ollama_usage.json
# The Synthetic secrets file must export SYNTHETIC_API_KEY; the Ollama one must
# export OLLAMA_CLOUD_API_KEY.
# Personal Proton Mail counts (read-only IMAP STATUS through local Bridge).
# Each *_FILE is a mode-600 single-line file; mailbox names come from --list.
PROTON_MAIL_COUNTS_USERNAME_FILE=/path/to/private/bridge-imap-username
PROTON_MAIL_COUNTS_PASSWORD_FILE=/path/to/private/bridge-imap-password
PROTON_MAIL_COUNTS_CA_FILE=/path/to/private/bridge-cert.pem
PROTON_MAIL_COUNTS_OUTPUT=/path/to/home-assistant/config/personal_mail_counts.json
PROTON_MAIL_COUNTS_MAILBOXES=inbox=INBOX;todo=Labels/Todo;todo_lower_priority=Labels/Todo, lower priority
