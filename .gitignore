# Deny by default. /opt contains application data, source code, configuration,
# credentials, certificates, databases, logs, backups, and temporary files.
/*

# Readme
!/README.md

# Repository metadata and sanitized templates.
!/.gitignore
!/.env.example

# Primary Compose project.
!/docker-compose.yaml

# Repository automation.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/validate-stack.yml
!/scripts/
/scripts/*
!/scripts/validate-stack.sh

# Reviewed Caddy build and routing definitions. Runtime data, configuration,
# and secrets below /opt/caddy remain ignored.
!/caddy/
/caddy/*
!/caddy/Caddyfile
!/caddy/Dockerfile

# Reviewed observability project files. Its .env, secrets, provisioning state,
# and persistent data remain ignored.
!/observability/
/observability/*
!/observability/.env.example
!/observability/compose.yaml
!/observability/README.md
!/observability/alloy-config.alloy
!/observability/loki-config.yaml
