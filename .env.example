# Copy this file to /opt/.env and replace every placeholder.
# Never commit /opt/.env.
SESSION_SECRET=replace-with-a-long-random-value
TZ=Region/City
ZWAVE_DEVICE=/dev/serial/by-id/replace-with-device-id
POSTGRES_USER=replace-with-database-user
POSTGRES_DB=replace-with-database-name
COUNTDOWN_IMAGE=registry.example/owner/countdown-timer:tag
CPA_API_POLICY_IP=10.60.0.2
CPA_API_MANAGEMENT_IP=10.61.0.2
CPA_API_EGRESS_IP=10.62.0.2
