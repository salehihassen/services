AI_POLICY_PROXY_IP=10.60.0.3
CADDY_IMAGE=local-caddy:tag
CADDY_CONTAINER_NAME=local-caddy
CADDY_BIND_ADDRESSES="100.64.0.10 [fd7a:0000:0000::10]"
