# Loki log API, tailnet-only like the other private sites. Same tls resolver
# override as the quote site: the zone's wildcard CNAME breaks the local ACME
# propagation check.
https://{$LOKI_DOMAIN} {
	bind {$CADDY_BIND_ADDRESSES}

	tls {
		dns porkbun {
			api_key {file./run/secrets/porkbun_api_key}
			api_secret_key {file./run/secrets/porkbun_api_secret_key}
		}
		resolvers 1.1.1.1 8.8.8.8
		propagation_delay 30s
		propagation_timeout 5m
	}

	# Write-only door: log writers authenticate, and only push/readiness paths
	# exist here. Reads stay behind Grafana's login over the docker network.
	@push path /loki/api/v1/push /ready
	handle @push {
		basic_auth {
			logshipper {$LOKI_WRITER_PASSWORD_HASH}
		}
		reverse_proxy http://127.0.0.1:3100 {
			header_up -Tailscale-*
		}
	}
	handle {
		respond "log push endpoint only; read logs via {$GRAFANA_DOMAIN}" 403
	}
}

https://{$COUNTDOWN_DOMAIN} {
	bind {$CADDY_BIND_ADDRESSES}

	reverse_proxy http://127.0.0.1:8081 {
		header_up -Tailscale-*
	}
}

https://{$QUOTE_DOMAIN} {
	bind {$CADDY_BIND_ADDRESSES}

	# The zone has a wildcard CNAME. The host's stub resolver answers the
	# ACME challenge name with that wildcard
	# instead of the TXT record Caddy just wrote -- verified against the
	# registrar, and it persists across `resolvectl flush-caches` -- so the
	# DNS-01 propagation check never completes. Public resolvers see the TXT
	# correctly, so ask them directly. Remove this only if the wildcard goes.
	tls {
		dns porkbun {
			api_key {file./run/secrets/porkbun_api_key}
			api_secret_key {file./run/secrets/porkbun_api_secret_key}
		}
		resolvers 1.1.1.1 8.8.8.8
		propagation_delay 30s
		propagation_timeout 5m
	}

	reverse_proxy http://127.0.0.1:8088 {
		header_up -Tailscale-*
	}
}

# Alias for the canonical quote site. Temporary (302) rather than permanent so the
# canonical name can still be changed later without browsers holding a cached
# 301. Needs its own tls block for the same reason quote.d does -- see above.
https://{$QUOTES_DOMAIN} {
	bind {$CADDY_BIND_ADDRESSES}

	tls {
		dns porkbun {
			api_key {file./run/secrets/porkbun_api_key}
			api_secret_key {file./run/secrets/porkbun_api_secret_key}
		}
		resolvers 1.1.1.1 8.8.8.8
		propagation_delay 30s
		propagation_timeout 5m
	}

	redir https://{$QUOTE_DOMAIN}{uri} temporary
}
