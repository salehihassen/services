https://{$SPEAK_DOMAIN} {
	bind {$CADDY_BIND_ADDRESSES}

	# Reject oversized bodies before FastAPI parses JSON. Keep this aligned with
	# conversion.max_body_bytes in /opt/speakable/config.yaml.
	request_body {
		max_size 256KB
	}

	# Use public resolvers for DNS-01 while the zone has a wildcard CNAME.
	tls {
		dns porkbun {
			api_key {file./run/secrets/porkbun_api_key}
			api_secret_key {file./run/secrets/porkbun_api_secret_key}
		}
		resolvers 1.1.1.1 8.8.8.8
		propagation_delay 30s
		propagation_timeout 5m
	}

	reverse_proxy http://127.0.0.1:8900 {
		header_up -Tailscale-*
	}
}

