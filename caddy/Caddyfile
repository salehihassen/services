# Direct CLIProxyAPI access for tailnet clients. Management stays on its
# existing SSH-tunnel path rather than being published through this hostname.
https://{$CPA_DOMAIN} {
	bind {$CADDY_BIND_ADDRESSES}

	tls {
		dns porkbun {
			api_key {file./run/secrets/porkbun_api_key}
			api_secret_key {file./run/secrets/porkbun_api_secret_key}
		}
		resolvers 1.1.1.1 8.8.8.8
		propagation_delay 30s
		propagation_timeout 5m
	}

	@management path /v0/management /v0/management/*
	respond @management 403

	reverse_proxy http://{$CPA_UPSTREAM} {
		header_up -Tailscale-*
	}
}

